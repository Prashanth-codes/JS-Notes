Another example:
function getUsername(username, callback){
    console.log("Getting users from database");
    setTimeout(()=>{
        let user = {
            id: 1,
            username: username,
            password: "1234"
        }
        console.log("User found", user.username);
        callback(user);
    },2000);
}

function verifyPass(user, password, callback){
    console.log("Verifying password");
    setTimeout(()=>{
        if (user.password === password){
            console.log("Pass verified");
            callback(user);
        }
    },2000)
}

function getProfile(user,callback){
    console.log("Fetching details");
    setTimeout(()=>{
        let profile = {
            id: 1,
            username: user.username,
            age: 24
        }
        console.log("Details fetched");
        callback(profile);
    },2000)
}

function dashboard(profile, callback){
    console.log("Dashboard");
    setTimeout(()=>{
        console.log("Hii", profile.username);
        callback();
    },2000)
}

const username = "Prashanth";
const password = "1234";

getUsername(username, function(user){
    verifyPass(user, password, function(user){
        getProfile(user, function(profile){
            dashboard(profile, function(){
                console.log("All done");
            });
        });
    });
});

