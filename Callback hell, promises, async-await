function createOrder(cart, callback) {
    console.log("Creating order...");

    setTimeout(function () {
        let orderId = "ORD123";

        console.log("Order created:", orderId);

        callback(orderId);
    }, 1000);
}

function proceedToPayment(orderId, callback) {
    console.log("Processing payment for:", orderId);

    setTimeout(function () {
        let paymentInfo = "Payment Successful";

        console.log(paymentInfo);

        callback(paymentInfo);
    }, 1000);
}

function showOrderSummary(paymentInfo, callback) {
    console.log("Preparing order summary...");

    setTimeout(function () {
        let summary = "Order summary displayed";

        console.log(summary);

        callback(summary);
    }, 1000);
}

function updateWallet(summary, callback) {
    console.log("Updating wallet...");

    setTimeout(function () {
        console.log("Wallet updated with cashback");
        callback();
    }, 1000);
}

let cart = ["Shoes", "T-Shirt", "Watch"];

createOrder(cart, function(orderId) {

    proceedToPayment(orderId, function(paymentInfo) {

        showOrderSummary(paymentInfo, function(summary) {

            updateWallet(summary, function() {

                console.log("All steps completed");

            });

        });

    });

});


