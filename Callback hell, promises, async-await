    })
}

function proceedToPayment(orderId){
    return new Promise(function(resolve,reject){
        console.log("processing payment for: ",orderId);
        setTimeout(function(){
            let info = "payment successful";
            console.log(info);
            resolve(info);
        },1000);
    })
}

function showOrderSummary(paymentInfo) {
    return new Promise(function(resolve,reject){
        console.log("Preparing order summary...");
        setTimeout(function () {
            let summary = "Order summary displayed";
            console.log(summary);
            resolve(summary);
        }, 1000);
    })
}

function updateWallet(summary) {
    return new Promise(function(resolve,reject){
        console.log("Updating wallet...");
        setTimeout(function () {
            console.log("Wallet updated with cashback");
            resolve("All steos dobe");
        }, 1000);
    })
}

let cart = ["Shoes", "T-Shirt", "Watch"];
async function processOrder() {
    try {
        let orderId = await createOrder(cart);
        let payment = await proceedToPayment(orderId);
        let summary = await showOrderSummary(payment);
        let result = await updateWallet(summary);
        console.log(result);
    } catch(error) {
        console.log("Error:", error);
    }
}
processOrder();
